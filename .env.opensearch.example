OPENSEARCH_INITIAL_ADMIN_PASSWORD=ChangeMe_To_A_Strong_Password_123!
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=your-workspace-id
# Preferred (Beijing workspace-dedicated host). Path MUST be /compatible-mode/v1 for embeddings.
# Docs: https://help.aliyun.com/zh/model-studio/embedding-interfaces-compatible-with-openai
DASHSCOPE_EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Legacy global host still works, but Aliyun recommends migrating away from it:
# DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
